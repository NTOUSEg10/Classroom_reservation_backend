ENVIRONMENT=development
DATABASE_URL=postgresql://ntou_api:CHANGE_ME@localhost:5432/ntou
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Prefer an sb_secret_ key; SUPABASE_SERVICE_ROLE_KEY remains a legacy alias.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
FRONTEND_ORIGIN=http://127.0.0.1:5173
VAPID_PUBLIC_KEY=
# Generate a private random value; use the SAME value in dispatch-push Secrets.
# Local development may leave this blank while PUSH_DISPATCH_ENABLED=false.
DISPATCH_SECRET=
DEMO_DATA=true
POOL_MAX_SIZE=20
AUTH_RATE_LIMIT=10
AUTH_IP_RATE_LIMIT=300
ENABLE_NOTIFICATION_WORKER=true
PUSH_DISPATCH_ENABLED=false
# Production requires a real hostname, HTTPS origins, verify-full DB TLS,
# DEMO_DATA=false, and configured Web Push secrets.
APP_DOMAIN=classrooms.example.edu.tw
